# App passwords, one per account. Never the main account password.
#
# Copy to .env next to docker-compose.yaml and fill in.
# Make sure .env is chmod 600 and excluded from git (it is, via .gitignore).

IMAP_MCP_ADDONWARE_PASSWORD=
IMAP_MCP_ICLOUD_PASSWORD=
IMAP_MCP_STROEMLAND_PASSWORD=

# Bind address inside the container. Leave as 0.0.0.0 and publish the
# port only on localhost in docker-compose, so the server is reachable
# solely through your reverse proxy.
IMAP_MCP_HTTP_HOST=0.0.0.0
IMAP_MCP_HTTP_PORT=8770
