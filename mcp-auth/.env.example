# Public issuer URL — must match exactly what the resource server
# advertises in its authorization_servers list.
MCP_AUTH_ISSUER=https://mcp.timbeck.de/auth

# The one resource this server mints tokens for. A token request naming
# anything else is refused. This must equal imap-mcp's `audience`.
MCP_AUTH_RESOURCE=https://mcp.timbeck.de/mcp

MCP_AUTH_SCOPES=mail:read

# Dynamic Client Registration is open by protocol necessity — Claude
# cannot be handed a client_id, it has to create one. This allowlist is
# what keeps that safe: a client may only register redirect URIs that
# start with one of these. Without it, anyone could register a client
# that sends your authorization codes to their own server.
MCP_AUTH_ALLOWED_REDIRECT_PREFIXES=https://claude.ai/api/mcp/auth_callback

# Produced by:  mcp-auth init-user
# The password is never stored, only its Argon2id hash.
MCP_AUTH_USERNAME=
MCP_AUTH_PASSWORD_HASH=
MCP_AUTH_TOTP_SECRET=
MCP_AUTH_SESSION_SECRET=

MCP_AUTH_PRIVATE_KEY=/data/signing-key.pem
MCP_AUTH_DB=/data/auth.db
MCP_AUTH_ACCESS_TTL=3600
