# App passwords, one per account. Never the main account password.
#
# iCloud:      appleid.apple.com -> App-Specific Passwords
#              (the same one you use for IMAP works here)
# mailbox.org: Einstellungen -> Sicherheit -> Applikationspasswörter,
#              type "Kalender- und Adressbuch-Client (CalDAV/CardDAV)".
#              The Mail-App-Passwort will NOT work for calendars.

DAV_MCP_ICLOUD_PASSWORD=
DAV_MCP_ADDONWARE_PASSWORD=

DAV_MCP_HTTP_HOST=0.0.0.0
DAV_MCP_HTTP_PORT=8771
